# ---------- AI solver (server only) ----------
# --- AI that reads the student's question (it only classifies it; the drawing is exact code) ---
# Default: Anthropic Claude.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5        # cheaper: claude-sonnet-5-5 or claude-haiku-5-5
#
# Or another provider (pick a model that accepts images, or photo uploads fail):
# AI_PROVIDER=nvidia                     # nvidia | gemini | openrouter | groq | together
# AI_API_KEY=
# AI_MODEL=                              # the model name exactly as that provider lists it
#
# Or your own server that speaks the OpenAI chat-completions API (vLLM, Ollama, LM Studio, TGI...):
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://your-gpu-server.example.com/v1
# AI_MODEL=
# AI_API_KEY=                            # if your server needs one
# AI_PROVIDER_LABEL=                     # company name for the privacy policy, if any

# ---------- Supabase: sign-in + database ----------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Razorpay: payments (use rzp_test_ keys until you go live) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks: the secret you type when you add the webhook
RAZORPAY_WEBHOOK_SECRET=
# Dashboard > Subscriptions > Plans. The amount must match lib/pricing.ts exactly:
#   monthly = PAID_PLANS.pro_monthly.amountPaise, yearly = PAID_PLANS.pro_yearly.amountPaise
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_YEARLY=

# Public origin (canonical/preview links, robots, sitemap). NEXT_PUBLIC_*: set at build time, redeploy after changing.
NEXT_PUBLIC_SITE_URL=

# Vercel Web Analytics: switch it on in the Vercel project first, then set this to "on" and redeploy.
NEXT_PUBLIC_ANALYTICS=
